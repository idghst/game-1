; Engine configuration file.
config_version=5

[application]

config/name="Hollow Vigil"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Fx="*res://scripts/autoload/fx.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/default_font_antialiasing=0

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]
}
aim_left={
"deadzone": 0.3,
"events": [Object(InputEventJoypadMotion,"axis":2,"axis_value":-1.0)]
}
aim_right={
"deadzone": 0.3,
"events": [Object(InputEventJoypadMotion,"axis":2,"axis_value":1.0)]
}
aim_up={
"deadzone": 0.3,
"events": [Object(InputEventJoypadMotion,"axis":3,"axis_value":-1.0)]
}
aim_down={
"deadzone": 0.3,
"events": [Object(InputEventJoypadMotion,"axis":3,"axis_value":1.0)]
}
dash={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventKey,"physical_keycode":4194325), Object(InputEventJoypadButton,"button_index":9), Object(InputEventJoypadMotion,"axis":4,"axis_value":1.0)]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventJoypadButton,"button_index":2)]
}
shoot={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1), Object(InputEventJoypadMotion,"axis":5,"axis_value":1.0)]
}

[internationalization]

locale/translations=PackedStringArray("res://translations/strings.en.translation", "res://translations/strings.ko.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
