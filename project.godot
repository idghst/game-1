; Engine configuration file.
config_version=5

[application]

config/name="Hollow Vigil"
run/main_scene="res://title.tscn"
config/version="0.9.0"
config/icon="res://assets/logo/icon.svg"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Fx="*res://scripts/autoload/fx.gd"
Sfx="*res://scripts/autoload/audio.gd"
SteamService="*res://scripts/autoload/steam_service.gd"
Profile="*res://scripts/autoload/profile.gd"
Achievements="*res://scripts/autoload/achievements.gd"
Settings="*res://scripts/autoload/settings.gd"
Smoke="*res://scripts/autoload/smoke.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/default_font_antialiasing=0

